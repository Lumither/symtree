{
  "rust":       { "lsp": "rust-analyzer",                          "language_id": "rust",       "extensions": ["rs"] },
  "python":     { "lsp": "pyright-langserver --stdio",             "language_id": "python",     "extensions": ["py", "pyi"] },
  "go":         { "lsp": "gopls",                                  "language_id": "go",         "extensions": ["go"] },
  "typescript": { "lsp": "typescript-language-server --stdio",     "language_id": "typescript", "extensions": ["ts", "tsx", "mts", "cts"] },
  "javascript": { "lsp": "typescript-language-server --stdio",     "language_id": "javascript", "extensions": ["js", "jsx", "mjs", "cjs"] },
  "lua":        { "lsp": "lua-language-server",                    "language_id": "lua",        "extensions": ["lua"] },
  "ocaml":      { "lsp": "ocamllsp",                               "language_id": "ocaml",      "extensions": ["ml", "mli"] },
  "swift":      { "lsp": "sourcekit-lsp",                          "language_id": "swift",      "extensions": ["swift"] },
  "c":          { "lsp": "clangd",                                 "language_id": "c",          "extensions": ["c", "h"] },
  "cpp":        { "lsp": "clangd",                                 "language_id": "cpp",        "extensions": ["cpp", "cc", "cxx", "hpp", "hh", "hxx"] },
  "bash":       { "lsp": "bash-language-server start",             "language_id": "shellscript","extensions": ["sh", "bash"] },
  "haskell":    { "lsp": "haskell-language-server-wrapper --lsp",  "language_id": "haskell",    "extensions": ["hs", "lhs"] },
  "ruby":       { "lsp": "solargraph stdio",                       "language_id": "ruby",       "extensions": ["rb"] },
  "java":       { "lsp": "jdtls",                                  "language_id": "java",       "extensions": ["java"] },
  "kotlin":     { "lsp": "kotlin-language-server",                 "language_id": "kotlin",     "extensions": ["kt", "kts"] },
  "zig":        { "lsp": "zls",                                    "language_id": "zig",        "extensions": ["zig"] },
  "nim":        { "lsp": "nimlangserver",                          "language_id": "nim",        "extensions": ["nim"] },
  "elixir":     { "lsp": "lexical",                                "language_id": "elixir",     "extensions": ["ex", "exs"] },
  "scala":      { "lsp": "metals",                                 "language_id": "scala",      "extensions": ["scala", "sc"] },
  "dart":       { "lsp": "dart language-server",                   "language_id": "dart",       "extensions": ["dart"] },
  "elm":        { "lsp": "elm-language-server",                    "language_id": "elm",        "extensions": ["elm"] },
  "fortran":    { "lsp": "fortls",                                 "language_id": "fortran",    "extensions": ["f", "f90", "f95"] },
  "json":       { "lsp": "vscode-json-language-server --stdio",    "language_id": "json",       "extensions": ["json", "jsonc"] },
  "yaml":       { "lsp": "yaml-language-server --stdio",           "language_id": "yaml",       "extensions": ["yaml", "yml"] },
  "toml":       { "lsp": "taplo lsp stdio",                        "language_id": "toml",       "extensions": ["toml"] },
  "markdown":   { "lsp": "marksman server",                        "language_id": "markdown",   "extensions": ["md", "markdown"] }
}
